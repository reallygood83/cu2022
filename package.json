{
  "name": "2022cu-kr0-mcp",
  "version": "1.1.1",
  "description": "기준인용 MCP (CiteCurriculum KR) — 2022 개정 교육과정 성취기준 검색·Lesson Pack·cite-only 검증",
  "type": "module",
  "bin": {
    "2022cu-kr0-mcp": "./dist/index.js",
    "cu2022-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "data",
    "docs",
    "examples",
    "qa",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && node scripts/chmod-bin.mjs",
    "build:data": "node scripts/build-index.mjs",
    "repair:data": "node scripts/repair-index.mjs",
    "prepare": "npm run build",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "qa:smoke": "node scripts/mcp-qa-smoke.mjs"
  },
  "keywords": [
    "mcp",
    "curriculum",
    "korea",
    "2022",
    "성취기준",
    "교육과정",
    "cite-only",
    "teachers",
    "standards"
  ],
  "author": "reallygood83",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reallygood83/2022CU-kr0-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/reallygood83/2022CU-kr0-mcp/issues"
  },
  "homepage": "https://github.com/reallygood83/2022CU-kr0-mcp#readme"
}
